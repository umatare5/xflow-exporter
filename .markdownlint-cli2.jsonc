{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD013": false,
    "MD024": { "siblings_only": true },
    // Two adjacent GitHub alerts cannot be written without a blank line between them
    "MD028": false,
    "MD029": { "style": "ordered" },
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD050": { "style": "asterisk" },
    "MD054": { "url_inline": false },
    "MD055": { "style": "leading_and_trailing" },
    "MD060": { "style": "aligned", "aligned_delimiter": true }
  },
  "overrides": [
    {
      "filter": ["AGENTS.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Repository Instructions",
            "## Tech Stack", "*",
            "## Repository Structure", "*",
            "## Setup and Commands", "*",
            "## Code Style", "*",
            "## Testing", "*",
            "## Commits and PRs", "*",
            "## Domain Knowledge", "*"
          ]
        }
      }
    },
    {
      "filter": ["CHANGELOG.md"],
      "combine": "merge",
      "config": {
        // Release headings accrue, so only the standing section is pinned
        "MD043": {
          "match_case": true,
          "headings": [
            "# Changelog",
            "## [Unreleased]",
            "*"
          ]
        }
      }
    },
    {
      "filter": ["CONTRIBUTING.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Contributing",
            "## Development", "*",
            "## Testing"
          ]
        }
      }
    },
    {
      "filter": ["README.md"],
      "combine": "merge",
      "config": {
        // The logo, badges and title block are HTML; the heading they carry is an <h1>
        "MD033": {
          "allowed_elements": ["a", "br", "div", "h1", "img", "p", "picture", "source"]
        },
        "MD041": { "allow_preamble": true },
        "MD043": {
          "match_case": true,
          "headings": [
            "## Overview", "*",
            "## Architecture", "*",
            "## Supported Environment", "*",
            "## Installation", "*",
            "## Quick Start", "*",
            "## Configuration", "*",
            "## Metrics", "*",
            "## Examples", "*",
            "## Documentation", "*",
            "## Contributing", "*",
            "## License"
          ]
        }
      }
    },
    {
      "filter": ["SECURITY.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Security Policy",
            "## What to Include", "*",
            "## Exposure", "*",
            "## Endpoints", "*",
            "## Ingress Paths", "*",
            "## Egress Paths", "*",
            "## Out of Scope"
          ]
        }
      }
    },
    {
      "filter": ["docs/README.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Documentation",
            "## For Users Docs", "*",
            "## For Developers Docs"
          ]
        }
      }
    },
    {
      "filter": ["docs/architecture.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Architecture",
            "## Scrape Path", "*",
            "## Endpoints", "*",
            "## Absence", "*",
            "## Decoder", "*",
            "## Sampling Correction", "*",
            "## Counter Semantics", "*",
            "## Bounded State", "*",
            "## Dashboards"
          ]
        }
      }
    },
    {
      "filter": ["docs/collectors.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Collectors",
            "## Metrics", "*",
            "## Labels", "*",
            "## Annotations", "*",
            "## Technical Notes"
          ]
        }
      }
    },
    {
      "filter": ["docs/enrichment.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Enrichment",
            "## Sources", "*",
            "## Databases", "*",
            "## Mapping File", "*",
            "## Service Names", "*",
            "## Threat Lists"
          ]
        }
      }
    },
    {
      "filter": ["docs/help.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Help",
            "## Flags", "*",
            "## Technical Notes"
          ]
        }
      }
    },
    {
      "filter": ["docs/health.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Exporter Health",
            "## Metrics", "*",
            "## Labels", "*",
            "## Annotations", "*",
            "## Technical Notes"
          ]
        }
      }
    },
    {
      "filter": ["docs/protocols.md"],
      "combine": "merge",
      "config": {
        // Each record layout is folded into a <details> block the reader opens on demand
        "MD033": {
          "allowed_elements": ["b", "details", "p", "summary"]
        },
        "MD043": {
          "match_case": true,
          "headings": [
            "# Protocols",
            "## Verification Matrix", "*",
            "## Version Identification", "*",
            "## NetFlow v5", "*",
            "## NetFlow v8", "*",
            "## NetFlow v9", "*",
            "## IPFIX", "*",
            "## sFlow v5", "*",
            "## Packet Sections", "*",
            "## References"
          ]
        }
      }
    }
  ],
  "globs": ["**/*.md"],
  "gitignore": true,
  // Both are symlinks to AGENTS.md, which is linted on its own path
  "ignores": [".claude/CLAUDE.md", ".github/copilot-instructions.md"]
}
